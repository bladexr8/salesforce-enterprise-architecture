</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Fastest_Lap_Time</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Update AI Prompt with info no Qualifying Records found</description>
        <name>Prompt_No_Qualifying_Records</name>
        <elementSubtype>AddPromptInstructions</elementSubtype>
        <label>Prompt No Qualifying Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Output.Prompt</assignToReference>
