<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Send info to prompt no Driver Results found</description>
        <name>Prompt_No_Driver_Results</name>
        <elementSubtype>AddPromptInstructions</elementSubtype>
        <label>Prompt No Driver Results</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Output.Prompt</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>No Driver Results found for F1 Race
</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Team_Results</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Update Prompt with info no Lap Times found</description>
        <name>Prompt_No_Lap_TImes_Found</name>
